		<VariableSystem>
			<VariableSystem.Channels>
				<Channel Name="Internal" ChannelType="Intern">
					<Channel.Variables>
						<Node Name="__SYSTEM">
							<Node Name="MEMORY">
								<Variable Name="PERCENTLOAD" DataType="Double" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the percentage of memory utilization" IsSystem="True" />
								<Variable Name="PHYSICAL" DataType="Double" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the size of the free physical memory" IsSystem="True" />
							</Node>
							<Variable Name="TIME" DataType="DateTime" ClientIntern="True" Comment="Client-internal system variable: current local time of the client machine" IsSystem="True" />
							<Variable Name="ACKNOWLEDGE_RESET" DataType="Boolean" Comment="Reset acknowledge state of all alarms" IsSystem="True" />
							<Variable Name="ACTIVE_ALARMS" DataType="Int32" AccessRight="Read" Comment="Number of active alarms (not acknowledged)" IsSystem="True" />
							<Variable Name="ACTIVE_ITEMS" DataType="Int32" AccessRight="Read" Comment="Displays amount of connected items" IsSystem="True" />
							<Variable Name="CYCLE_MAX" DataType="Int32" AccessRight="Read" Comment="Maximum system cycle time" IsSystem="True" />
							<Variable Name="CYCLE_TIME" DataType="Int32" AccessRight="Read" Comment="Current system cycle time" IsSystem="True" />
							<Variable Name="SYSTEM_STATE" DataType="Int32" Comment="Internal status of the project server" IsSystem="True" />
							<Variable Name="SYSTEM_ALARM_CONTROL" DataType="Int32" Comment="Control variable to deactivate system alarms." IsSystem="True" />
						</Node>
						<Node Name="__PROCESS">
							<Node Name="MEMORY">
								<Variable Name="AVAILABLE" DataType="Double" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the size of the available memory for this application" IsSystem="True" />
								<Variable Name="ESTIMATEDMANAGED" DataType="Double" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the estimated size of the managed memory of this application" IsSystem="True" />
								<Variable Name="USED" DataType="Double" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the size of the memory used by this application" IsSystem="True" />
							</Node>
						</Node>
						<Node Name="__CURRENT_USER">
							<Variable Name="NAME" DataType="String" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the name of the user currently logged on" IsSystem="True" />
							<Variable Name="FULLNAME" DataType="String" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the full name of the user currently logged on" IsSystem="True" />
							<Variable Name="GROUPNAME" DataType="String" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the name of the user group object of the user currently logged on" IsSystem="True" />
							<Variable Name="GROUPTEXT" DataType="String" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the language-switchable user group text of the user currently logged on" IsSystem="True" />
							<Variable Name="LEVEL" DataType="Int32" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the authorization level of the user currently logged on (only valid for level-oriented user system)" IsSystem="True" />
							<Variable Name="SECONDS_TO_AUTOLOGOFF" DataType="Int32" AccessRight="Read" ClientIntern="True" Comment="Client-internal system variable: contains the seconds until the user currently logged on logs off automatically" IsSystem="True" />
						</Node>
						<Node Name="__DEMO">
							<Variable Name="NumericVar2" DefaultValue="20" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="NumericVar1" DefaultValue="10" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="NumericVar3" DefaultValue="30" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="NumericVar4" DefaultValue="40" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="BarValue1" DefaultValue="10" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="BarValue2" DefaultValue="20" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="BarValue3" DefaultValue="30" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="BarValue4" DefaultValue="40" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="ConfigSpeed" DataType="Int32" DefaultValue="50" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="ConfigTemperature" DataType="Double" DefaultValue="22.5" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="ConfigEnabled" DataType="Boolean" DefaultValue="True" InsertIntoVariable="True" SendOnStartup="True" />
							<Variable Name="ConfigAutoMode" DataType="Boolean" DefaultValue="False" InsertIntoVariable="True" SendOnStartup="True" />
						</Node>
					</Channel.Variables>
				</Channel>
			</VariableSystem.Channels>
			<VariableSystem.VariableGroups>
				<VariableGroup Name="Standard" ActivationName="" Comment="Alle Variablen werden automatisch zuerst dieser Gruppe zugeordnet. Die Gruppe kann nicht gelöscht werden." ControlVariableFullName="" />
			</VariableSystem.VariableGroups>
