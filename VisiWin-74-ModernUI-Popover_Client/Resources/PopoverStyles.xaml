<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Popover Outer Margin - Defines the outer spacing for popover containers-->
    <Thickness x:Key="PopoverOuterMargin">12</Thickness>

    <!--Popover Section Margin - Defines the bottom spacing between popover sections-->
    <Thickness x:Key="PopoverSectionMargin">0,0,0,12</Thickness>

    <!--PopoverRootGrid-Style - Base grid container for popover content with outer margin-->
    <Style x:Key="PopoverRootGrid" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource PopoverOuterMargin}"/>
    </Style>

    <!--PopoverHeaderBand-Style - Colored header band for popover titles with rounded corners-->
    <Style x:Key="PopoverHeaderBand" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!--PopoverHeaderTitle-Style - Main title text in the popover header with bold white text-->
    <Style x:Key="PopoverHeaderTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!--PopoverHeaderSubtitle-Style - Subtitle text in the popover header with semi-transparent white-->
    <Style x:Key="PopoverHeaderSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!--PopoverSectionGroupBox-Style - GroupBox container for popover sections with border-->
    <Style x:Key="PopoverSectionGroupBox" TargetType="GroupBox">
        <Setter Property="Margin" Value="{StaticResource PopoverSectionMargin}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ForegroundDarkBrush}"/>
    </Style>

    <!--PopoverSectionHeader-Style - Header text for popover sections with semi-bold styling-->
    <Style x:Key="PopoverSectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundDarkBrush}"/>
    </Style>

    <!--PopoverBodyText-Style - Body text for popover content with text wrapping enabled-->
    <Style x:Key="PopoverBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundDarkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--PopoverMetaLabel-Style - Label text for metadata fields with bold font weight-->
    <Style x:Key="PopoverMetaLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundDarkBrush}"/>
    </Style>

    <!--PopoverMetaValue-Style - Value text for metadata fields with normal font weight-->
    <Style x:Key="PopoverMetaValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundDarkBrush}"/>
    </Style>

</ResourceDictionary>
