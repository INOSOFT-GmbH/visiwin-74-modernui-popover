<vw:View x:Class="HMI.Views.MainRegion.Popover.AdditionalHelpPopoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vw="http://inosoft.com/visiwin7"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="975" Height="670" Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFE53935" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22" 
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.ErrorCode}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.ErrorTitle}" FontSize="13" Foreground="#FFFCE4EC"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="13" Margin="8,0,0,12"
                   Foreground="{DynamicResource ApplicationForegroundBrush}"
                   Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.Description}"/>

        <GroupBox Grid.Row="2" Header="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.DiagnosisHeader}" Margin="0,0,0,12" Padding="8"
                  BorderBrush="{DynamicResource ApplicationForegroundBrush}">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="200">

                <vw:Gauge Width="350" Height="350"
                          VariableName="__DEMO.BarValue1"
                          RawLimitMin="0" RawLimitMax="10"
                          UnitText="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.UnitBar}"
                          UnitTextVisibility="Visible"
                          ValueTextVisibility="Visible"
                          LabelText="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.SystemPressure}"
                          LabelTextVisibility="Visible"
                          LabelTextMargin="0,0,0,150"
                          Background="#20808080"
                          RulerBaseLineFill="#60808080"/>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0" Width="200">

                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                               Foreground="{DynamicResource ApplicationForegroundBrush}"
                               Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.BulletTargetPressure}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                               Foreground="{DynamicResource ApplicationForegroundBrush}"
                               Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.BulletLowPressure}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource ApplicationForegroundBrush}"
                               Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.BulletCheckCompressor}"/>

                </StackPanel>

            </StackPanel>

        </GroupBox>

        <GroupBox Grid.Row="3" Header="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.ChecklistHeader}" Margin="0,0,0,12" Padding="8"
                  BorderBrush="{DynamicResource ApplicationForegroundBrush}">
            <UniformGrid Columns="2">
            <vw:CheckBox LabelText="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.Check1}"
                             Margin="0,4"/>
            <vw:CheckBox LabelText="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.Check2}"
                             Margin="0,4"/>
            <vw:CheckBox LabelText="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.Check3}"
                             Margin="0,4"/>
            <vw:CheckBox LabelText="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.Check4}"
                             Margin="0,4"/>
            </UniformGrid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.MaintenanceHeader}" Margin="0,0,0,12" Padding="8"
                  BorderBrush="{DynamicResource ApplicationForegroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource ApplicationForegroundBrush}"
                           Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.AdditionalHelp.MaintenanceText}"/>
                <vw:Switch Grid.Column="1" VariableName="__DEMO.BarValue2" 
                           Width="60" Height="30"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="5"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">

            <vw:Button LocalizableText="@Views.Popover.AdditionalHelp.AcknowledgeError"
                       Width="160" Height="40"
                       HorizontalAlignment="Right"
                       Margin="0,0,8,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <vw:SetVariableAction VariableName="__DEMO.BarValue1" Value="15"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </vw:Button>

            <vw:Button LocalizableText="@Views.Popover.AdditionalHelp.Close"
                       Style="{DynamicResource FlatButton}"
                       Width="120" Height="40"
                       HorizontalAlignment="Right">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <vw:CloseAllPopoversAction PopoverPanelName="AdditionalHelpPanel"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </vw:Button>

        </StackPanel>

    </Grid>
    
</vw:View>
