<vw:View x:Class="HMI.Views.MainRegion.Popover.CloseOnBackgroundView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vw="http://inosoft.com/visiwin7"
         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" MinWidth="600" MinHeight="500" Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Style="{DynamicResource PopoverRootGrid}" Background="Transparent">

        <i:Interaction.Triggers>

            <i:EventTrigger EventName="MouseDown">

                <vw:CloseAllPopoversAction PopoverPanelName="CloseOnBackgroundPanel"/>

            </i:EventTrigger>

        </i:Interaction.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PopoverHeaderBand}">
            <StackPanel>
                <vw:TextBlock LocalizableText="@Views.Popover.CloseOnBackground.SampleTitle"
                           Style="{DynamicResource PopoverHeaderTitle}" />
                <vw:TextBlock LocalizableText="@Views.Popover.CloseOnBackground.SampleSubtitle"
                           Style="{DynamicResource PopoverHeaderSubtitle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource PrimaryExtraLightBrush}"
                CornerRadius="8" Padding="32" Cursor="Hand">

            <i:Interaction.Triggers>

                <i:EventTrigger EventName="PreviewMouseDown">

                    <vw:PopoverAction PopoverPanelName="CloseOnBackgroundPanel"
                                      PopoverViewName="CloseOnBackgroundPopoverView"
                                      LocalizableTitle="@Views.Popover.CloseOnBackground.PopoverTitle"
                                      Placement="Center"
                                      Alignment="OnElement"/>

                </i:EventTrigger>

            </i:Interaction.Triggers>

            <StackPanel HorizontalAlignment="Center">
                <vw:SymbolPresenter SymbolResourceKey="FeedbackIcon"/>
                <vw:TextBlock LocalizableText="@Views.Popover.CloseOnBackground.Button"
                           Style="{DynamicResource PopoverMetaLabel}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

        </Border>

        <vw:PopoverPanel x:Name="CloseOnBackgroundPanel" Grid.Row="0" Grid.RowSpan="2" />

    </Grid>

</vw:View>