<vw:View x:Class="HMI.Views.MainRegion.Popover.CustomSampleView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vw="http://inosoft.com/visiwin7"
         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" MinWidth="600" MinHeight="500" Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Style="{DynamicResource PopoverRootGrid}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PopoverHeaderBand}">
            <StackPanel>
                <TextBlock Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.SampleTitle}"
                           Style="{DynamicResource PopoverHeaderTitle}" />
                <TextBlock Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.SampleSubtitle}"
                           Style="{DynamicResource PopoverHeaderSubtitle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource PrimaryExtraLightBrush}"
                CornerRadius="8" Padding="32" Cursor="Hand">

            <i:Interaction.Triggers>

                <i:EventTrigger EventName="PreviewMouseDown">

                    <vw:PopoverAction PopoverPanelName="CustomElementPanel"
                                      Title="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.PopoverTitle}"
                                      Placement="Center"
                                      Alignment="OnElement">

                        <vw:PopoverAction.PopoverElement>

                            <vw:Popover Title="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.PopoverTitle}" Width="700" Height="460">

                                <Grid MinWidth="420" Background="{DynamicResource ApplicationBackgroundBrush}">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{DynamicResource PopoverHeaderBand}">
                                        <StackPanel>
                                            <TextBlock
                                                Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.PopoverTitle}"
                                                Style="{DynamicResource PopoverHeaderTitle}" />
                                            <TextBlock
                                                Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.PopoverSubtitle}"
                                                Style="{DynamicResource PopoverHeaderSubtitle}" />
                                        </StackPanel>
                                    </Border>

                                    <GroupBox Grid.Row="1"
                                              Header="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.SectionGeneral}"
                                              Style="{DynamicResource PopoverSectionGroupBox}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.LabelSpeed}"
                                                       Style="{DynamicResource PopoverMetaLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                                        Margin="0,0,0,8">
                                                <vw:NumericVarIn VariableName="__DEMO.ConfigSpeed"
                                                                 Height="40" Width="120"
                                                                 RawLimitMin="0" RawLimitMax="100" />
                                                <TextBlock
                                                    Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.SpeedUnit}"
                                                    Style="{DynamicResource PopoverMetaValue}"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.LabelEnabled}"
                                                       Style="{DynamicResource PopoverMetaLabel}"
                                                       VerticalAlignment="Center" />
                                            <vw:Switch Grid.Row="1" Grid.Column="1"
                                                       VariableName="__DEMO.ConfigEnabled"
                                                       Width="60" Height="30"
                                                       HorizontalAlignment="Left" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Grid.Row="2"
                                              Header="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.SectionAdvanced}"
                                              Style="{DynamicResource PopoverSectionGroupBox}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.LabelTemperature}"
                                                       Style="{DynamicResource PopoverMetaLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                                        Margin="0,0,0,8">
                                                <vw:NumericVarIn VariableName="__DEMO.ConfigTemperature"
                                                                 Height="40" Width="120"
                                                                 RawLimitMin="-10" RawLimitMax="50" />
                                                <TextBlock
                                                    Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.TemperatureUnit}"
                                                    Style="{DynamicResource PopoverMetaValue}"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.LabelAutoMode}"
                                                       Style="{DynamicResource PopoverMetaLabel}"
                                                       VerticalAlignment="Center" />
                                            <vw:CheckBox Grid.Row="1" Grid.Column="1"
                                                         VariableName="__DEMO.ConfigAutoMode"
                                                         HorizontalAlignment="Left" />
                                        </Grid>
                                    </GroupBox>

                                    <TextBlock Grid.Row="3"
                                               Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.HelpText}"
                                               Style="{DynamicResource PopoverBodyText}"
                                               Margin="8,0,8,12" />

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                                Margin="0,0,8,8">

                                        <vw:Button LocalizableText="@Views.Popover.Config.ButtonReset"
                                                   Style="{DynamicResource FlatButton}"
                                                   Width="140" Height="40" Margin="0,0,8,0">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseDown">
                                                    <vw:SetVariableAction VariableName="__DEMO.ConfigSpeed" Value="50" />
                                                    <vw:SetVariableAction VariableName="__DEMO.ConfigTemperature"
                                                                          Value="22.5" />
                                                    <vw:SetVariableAction VariableName="__DEMO.ConfigEnabled"
                                                                          Value="True" />
                                                    <vw:SetVariableAction VariableName="__DEMO.ConfigAutoMode"
                                                                          Value="False" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </vw:Button>

                                        <vw:Button LocalizableText="@Views.Popover.Config.ButtonClose"
                                                   Width="120" Height="40">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseDown">
                                                    <vw:CloseAllPopoversAction PopoverPanelName="CustomElementPanel" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </vw:Button>

                                    </StackPanel>

                                </Grid>

                            </vw:Popover>

                        </vw:PopoverAction.PopoverElement>

                    </vw:PopoverAction>

                </i:EventTrigger>

            </i:Interaction.Triggers>

            <StackPanel HorizontalAlignment="Center">
                <vw:SymbolPresenter SymbolResourceKey="FeedbackIcon"/>
                <TextBlock Text="{vw:LocalizedTextBinding LocalizableText=@Views.Popover.Config.TapHint}"
                           Style="{DynamicResource PopoverMetaLabel}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

        </Border>

        <vw:PopoverPanel x:Name="CustomElementPanel" Grid.Row="0" Grid.RowSpan="2" />

    </Grid>

</vw:View>