<vw:View x:Class="HMI.Views.MainRegion.Popover.VarOutSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vw="http://inosoft.com/visiwin7"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" MinWidth="600" MinHeight="400" Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Style="{DynamicResource PopoverRootGrid}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PopoverHeaderBand}" Margin="0,0,0,8">
            <StackPanel>
                <vw:TextBlock LocalizableText="@Views.Popover.VarOut.SampleTitle" Style="{DynamicResource PopoverHeaderTitle}"/>
                <vw:TextBlock LocalizableText="@Views.Popover.VarOut.SampleSubtitle"
                           Style="{DynamicResource PopoverHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Rows="2" Columns="2" >
            
            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementLeft" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:NumericVarOut x:Name="VarOut1" 
                                  VariableName="__DEMO.NumericVar1" 
                                  Width="150" Height="50" UseVariableText="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="VarOutPopoverView"
                                              LocalizableTitle="@Views.Popover.VarOut.Variable1Title"
                                              Placement="Left"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:NumericVarOut>
            </StackPanel>

            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementRight" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:NumericVarOut x:Name="VarOut2" 
                                  VariableName="__DEMO.NumericVar2" 
                                  Width="150" Height="50" UseVariableText="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="VarOutPopoverView"
                                              LocalizableTitle="@Views.Popover.VarOut.Variable2Title"
                                              Placement="Right"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:NumericVarOut>
            </StackPanel>

            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementLeft" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:NumericVarOut x:Name="VarOut3" 
                                  VariableName="__DEMO.NumericVar3" 
                                  Width="150" Height="50" UseVariableText="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="VarOutPopoverView"
                                              LocalizableTitle="@Views.Popover.VarOut.Variable3Title"
                                              Placement="Left"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:NumericVarOut>
            </StackPanel>

            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementRight" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:NumericVarOut x:Name="VarOut4" 
                                  VariableName="__DEMO.NumericVar4" 
                                  Width="150" Height="50" UseVariableText="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="VarOutPopoverView"
                                              LocalizableTitle="@Views.Popover.VarOut.Variable4Title"
                                              Placement="Right"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:NumericVarOut>
            </StackPanel>

        </UniformGrid>
    </Grid>
    
</vw:View>
