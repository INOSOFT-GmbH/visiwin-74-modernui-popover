<vw:View x:Class="HMI.Views.MainRegion.Popover.BarSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vw="http://inosoft.com/visiwin7"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adapters="clr-namespace:HMI.Components"
    mc:Ignorable="d" MinWidth="600" MinHeight="400" Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Style="{DynamicResource PopoverRootGrid}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PopoverHeaderBand}" Margin="0,0,0,8">
            <StackPanel>
                <vw:TextBlock LocalizableText="@Views.Popover.Bar.SampleTitle" Style="{DynamicResource PopoverHeaderTitle}"/>
                <vw:TextBlock LocalizableText="@Views.Popover.Bar.SampleSubtitle"
                           Style="{DynamicResource PopoverHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Rows="2" Columns="2">
            
            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementLeft" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:Bar x:Name="Bar1" 
                        VariableName="__DEMO.BarValue1" 
                        Width="80" Height="200"  UseVariableText="True"
                        RawLimitMin ="0" RawLimitMax="100">
                    <vw:Bar.DataContext>
                        <adapters:BarRelationModel Var1="__DEMO.BarValue1" 
                                                     Var2="__DEMO.BarValue2" 
                                                     Var3="__DEMO.BarValue3" 
                                                     Var4="__DEMO.BarValue4"/>
                    </vw:Bar.DataContext>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="BarPopoverView"
                                              LocalizableTitle="@Views.Popover.Bar.Bar1Title"
                                              Placement="Left"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:Bar>
            </StackPanel>

            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementRight" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:Bar x:Name="Bar2" UseVariableText="True"
                        VariableName="__DEMO.BarValue2" 
                        Width="80" Height="200"
                        RawLimitMin="0" RawLimitMax="100">
                    <vw:Bar.DataContext>
                        <adapters:BarRelationModel Var1="__DEMO.BarValue1"  
                                                     Var2="__DEMO.BarValue2" 
                                                     Var3="__DEMO.BarValue3" 
                                                     Var4="__DEMO.BarValue4"/>
                    </vw:Bar.DataContext>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="BarPopoverView"
                                              LocalizableTitle="@Views.Popover.Bar.Bar2Title"
                                              Placement="Right"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:Bar>
            </StackPanel>

            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementLeft" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:Bar x:Name="Bar3" UseVariableText="True"
                        VariableName="__DEMO.BarValue3" 
                        Width="80" Height="200"
                        RawLimitMin="0" RawLimitMax="100">
                    <vw:Bar.DataContext>
                        <adapters:BarRelationModel Var1="__DEMO.BarValue1" 
                                                     Var2="__DEMO.BarValue2" 
                                                     Var3="__DEMO.BarValue3" 
                                                     Var4="__DEMO.BarValue4"/>
                    </vw:Bar.DataContext>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="BarPopoverView"
                                              LocalizableTitle="@Views.Popover.Bar.Bar3Title"
                                              Placement="Left"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:Bar>
            </StackPanel>

            <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <vw:TextBlock LocalizableText="@Views.Popover.Common.PlacementRight" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <vw:Bar x:Name="Bar4" UseVariableText="True"
                        VariableName="__DEMO.BarValue4" 
                        Width="80" Height="200"
                        RawLimitMin="0" RawLimitMax="100">
                    <vw:Bar.DataContext>
                        <adapters:BarRelationModel Var1="__DEMO.BarValue1" 
                                                     Var2="__DEMO.BarValue2" 
                                                     Var3="__DEMO.BarValue3" 
                                                     Var4="__DEMO.BarValue4"/>
                    </vw:Bar.DataContext>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDown">
                            <vw:PopoverAction PopoverViewName="BarPopoverView"
                                              LocalizableTitle="@Views.Popover.Bar.Bar4Title"
                                              Placement="Right"
                                              Alignment="OnElement"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </vw:Bar>
            </StackPanel>

        </UniformGrid>
    </Grid>
    
</vw:View>
