<vw:View x:Class="HMI.Views.MainRegion.Popover.AuthorizationSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vw="http://inosoft.com/visiwin7"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" MinWidth="600" MinHeight="400" Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Style="{DynamicResource PopoverRootGrid}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PopoverHeaderBand}" Margin="0,0,0,8">
            <StackPanel>
                <vw:TextBlock LocalizableText="@Views.Popover.Authorization.SampleTitle"
                              Style="{DynamicResource PopoverHeaderTitle}"/>
                <vw:TextBlock LocalizableText="@Views.Popover.Authorization.SampleSubtitle"
                              Style="{DynamicResource PopoverHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

            <vw:TextBlock LocalizableText="@Views.Popover.Authorization.Instruction"
                          Style="{DynamicResource PopoverBodyText}"
                          HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <vw:Button Content="Open Protected Popover" Width="250" Height="50" FontSize="16">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <vw:PopoverAction PopoverViewName="AuthorizationPopoverView"
                                          LocalizableTitle="@Views.Popover.Authorization.PopoverTitle"
                                          Placement="Bottom"
                                          Alignment="OnElement"
                                          AuthorizationRight="TestRight"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </vw:Button>

            <vw:TextBlock LocalizableText="@Views.Popover.Authorization.LoginHint"
                          Style="{DynamicResource PopoverBodyText}"
                          HorizontalAlignment="Center" Margin="0,20,0,0"
                          FontStyle="Italic" Opacity="0.7"/>

        </StackPanel>

    </Grid>

</vw:View>
