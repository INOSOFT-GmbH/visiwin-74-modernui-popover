<vw:View x:Class="HMI.Views.MainRegion.Popover.PieChartSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vw="http://inosoft.com/visiwin7"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" MinWidth="600" MinHeight="500" Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Style="{DynamicResource PopoverRootGrid}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PopoverHeaderBand}" Margin="0,0,0,8">
            <StackPanel>
                <vw:TextBlock LocalizableText="@Views.Popover.PieChart.SampleTitle" Style="{DynamicResource PopoverHeaderTitle}"/>
                <vw:TextBlock LocalizableText="@Views.Popover.PieChart.SampleSubtitle"
                           Style="{DynamicResource PopoverHeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            
            <vw:PieChart x:Name="MainPieChart"
                         Width="350" 
                         Height="350"
                         InnerCircleSize="80"
                         ValueUnitVisibility="Both"
                         LocalizableLabelText="@Views.Popover.PieChart.DemoLabel">
                
                <vw:PieSegment RawValue="30" 
                               Fill="{DynamicResource PrimaryBrush}" 
                               LocalizableText="@Views.Popover.PieChart.Segment1"/>

                <vw:PieSegment RawValue="45" 
                               Fill="{DynamicResource PrimaryLightBrush}" 
                               LocalizableText="@Views.Popover.PieChart.Segment2"/>

                <vw:PieSegment RawValue="25" 
                               Fill="{DynamicResource PrimaryDarkBrush}" 
                               LocalizableText="@Views.Popover.PieChart.Segment3"/>
                
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDown">
                        <vw:PopoverAction PopoverViewName="PieChartPopoverView"
                                          LocalizableTitle="@Views.Popover.PieChart.EditSegmentValues"
                                          Placement="Right"
                                          Alignment="OnElement"
                                          DataContext="{Binding ElementName=MainPieChart}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

            </vw:PieChart>
            
        </StackPanel>

    </Grid>
    
</vw:View>
